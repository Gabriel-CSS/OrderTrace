{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "docker",
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=ordertrace;Username=postgres;Password=postgres"
  },
  "OpenTelemetry": {
    "UseOtlpExporter": true,
    "OtlpEndpoint": "http://jaeger:4318"
  }
}
